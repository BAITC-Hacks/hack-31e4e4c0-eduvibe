MYSQL_DATABASE=eduvibe
MYSQL_USER=eduvibe
MYSQL_PASSWORD=eduvibe
MYSQL_ROOT_PASSWORD=change-for-non-local-use

DATABASE_URL=mysql+pymysql://eduvibe:eduvibe@db:3306/eduvibe
APP_NAME=EduVibe API
OPENAI_API_KEY=
# Необязательные настройки модели; значения по умолчанию указаны ниже.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20
AI_FALLBACK_ENABLED=true
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=/api/v1
